{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital-guide.local/schemas/bill.schema.json",
  "title": "Offline-Payment Bill",
  "type": "object",
  "additionalProperties": false,
  "required": ["billId", "patientId", "relatedEntities", "items", "totalAmount", "insuranceAmount", "personalAmount", "currency", "status", "paymentGuidance", "createdAt", "updatedAt"],
  "properties": {
    "billId": { "$ref": "common.schema.json#/$defs/billId" },
    "patientId": { "$ref": "common.schema.json#/$defs/patientId" },
    "encounterId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/encounterId" }, { "type": "null" }] },
    "relatedEntities": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/entityReference" }, "uniqueItems": true },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "name", "amount"],
        "properties": {
          "itemId": { "type": "string", "pattern": "^bill-item-[a-zA-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "amount": { "type": "number", "minimum": 0 }
        }
      }
    },
    "totalAmount": { "type": "number", "minimum": 0 },
    "insuranceAmount": { "type": "number", "minimum": 0 },
    "personalAmount": { "type": "number", "minimum": 0 },
    "currency": { "const": "CNY" },
    "status": { "type": "string", "enum": ["UNPAID", "PAID", "CANCELLED"] },
    "paymentProvider": { "type": ["string", "null"], "enum": [null, "SIMULATED"] },
    "paymentGuidance": { "type": "string", "minLength": 1, "maxLength": 100 },
    "createdAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/isoDateTime" }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "PAID" } }, "required": ["status"] },
    "then": { "required": ["paymentProvider"], "properties": { "paymentProvider": { "const": "SIMULATED" } } }
  }],
  "description": "PAID is allowed only for explicitly labelled simulated payments; no real provider is connected."
}
