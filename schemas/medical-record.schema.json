{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital-guide.local/schemas/medical-record.schema.json",
  "title": "Versioned Medical Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordId", "encounterId", "patientId", "status", "confirmedFacts", "versions", "createdAt", "updatedAt"],
  "properties": {
    "recordId": { "$ref": "common.schema.json#/$defs/medicalRecordId" },
    "encounterId": { "$ref": "common.schema.json#/$defs/encounterId" },
    "patientId": { "$ref": "common.schema.json#/$defs/patientId" },
    "status": { "type": "string", "enum": ["OPEN", "SIGNED", "CLOSED"] },
    "confirmedFacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/confirmedFact" }
    },
    "versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/version" }
    },
    "relatedEntities": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/entityReference" }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/isoDateTime" }
  },
  "$defs": {
    "confirmedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "field", "normalizedValue", "certainty", "confirmedAt"],
      "properties": {
        "factId": { "type": "string", "pattern": "^fact-[a-zA-Z0-9-]+$" },
        "field": { "enum": ["chiefConcern", "symptoms", "timeline", "vitalSigns", "patientHistory", "patientMedications", "patientAllergies", "patientQuestions"] },
        "normalizedValue": { "type": "string", "minLength": 1, "maxLength": 500 },
        "certainty": { "type": "string", "enum": ["PATIENT_CONFIRMED", "UNCERTAIN", "DENIED"] },
        "confirmedAt": { "$ref": "common.schema.json#/$defs/isoDateTime" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionNo", "content", "authorType", "changeReason", "createdAt"],
      "properties": {
        "versionNo": { "type": "integer", "minimum": 1 },
        "content": {
          "type": "object",
          "required": ["chiefComplaint", "symptomTimeline", "pastHistory", "medications", "allergies", "patientQuestions", "departmentRecommendations", "doctorNotes", "examinationResults", "doctorAssessment", "doctorPlan"],
          "properties": {
            "chiefComplaint": { "type": ["string", "null"] },
            "symptomTimeline": { "type": "array", "items": { "type": "object" } },
            "pastHistory": { "type": "array", "items": { "type": "object" } },
            "medications": { "type": "array", "items": { "type": "object" } },
            "allergies": { "type": "array", "items": { "type": "object" } },
            "patientQuestions": { "type": "array", "items": { "type": "string" } },
            "departmentRecommendations": { "type": "array", "items": { "type": "object" } },
            "doctorNotes": { "type": ["string", "null"] },
            "examinationResults": { "type": ["string", "null"] },
            "doctorAssessment": { "type": ["string", "null"] },
            "doctorPlan": { "type": ["string", "null"] }
          }
        },
        "authorType": { "type": "string", "enum": ["AGENT", "DOCTOR", "SYSTEM"] },
        "authorDoctorId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/doctorId" }, { "type": "null" }] },
        "changeReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "$ref": "common.schema.json#/$defs/isoDateTime" }
      }
    }
  }
}
