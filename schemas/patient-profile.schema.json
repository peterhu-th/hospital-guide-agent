{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital-guide.local/schemas/patient-profile.schema.json",
  "title": "Patient Profile",
  "description": "Patient-entered real-name profile. These four identity fields must come from the dedicated form, never Agent extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["patientId", "fullName", "identityNumber", "sex", "age", "birthDate", "verificationStatus", "createdAt", "lastActiveAt", "expiresAt"],
  "properties": {
    "patientId": { "$ref": "common.schema.json#/$defs/patientId" },
    "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "identityNumber": { "type": "string", "pattern": "^[1-9][0-9]{5}(18|19|20)[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx]$" },
    "sex": { "type": "string", "enum": ["female", "male"] },
    "age": { "type": "integer", "minimum": 0, "maximum": 130 },
    "birthDate": { "type": "string", "format": "date" },
    "verificationStatus": { "const": "SELF_DECLARED" },
    "createdAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "lastActiveAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "expiresAt": { "$ref": "common.schema.json#/$defs/isoDateTime" }
  }
}
